ANKE_ENVIRONMENT=local
ANKE_FIREBASE_PROJECT_ID=anke-money
ANKE_FIREBASE_CHECK_REVOKED=false
# Client configuration used only by the opt-in synthetic auth smoke.
ANKE_FIREBASE_WEB_API_KEY=
ANKE_FIREBASE_ALLOW_SYNTHETIC_USER=false
# Optional exact Development deployment target for the real-token smoke.
ANKE_FIREBASE_SMOKE_BASE_URL=
ANKE_FIREBASE_SMOKE_EXPECTED_HOST=
# Optional Key Vault-backed JSON for Azure. Never commit a real credential.
ANKE_FIREBASE_CREDENTIALS_JSON=
ANKE_COSMOS_ENDPOINT=https://cosmos-anke-money-dev-zq01.documents.azure.com:443/
ANKE_COSMOS_DATABASE=anke_money_dev
ANKE_COSMOS_ENTITIES_CONTAINER=anke_entities
ANKE_COSMOS_IDENTITIES_CONTAINER=anke_identities
ANKE_COSMOS_EXPECTED_ACCOUNT_NAME=cosmos-anke-money-dev-zq01
ANKE_COSMOS_ALLOW_SMOKE_WRITE=false
ANKE_AGENT_REQUESTS_PER_MINUTE=120
ANKE_AGENT_FAILED_AUTH_THRESHOLD=5
ANKE_MCP_ALLOWED_HOSTS=testserver,localhost:*,127.0.0.1:*
ANKE_MCP_ALLOWED_ORIGINS=
# Deployed Azure Functions: client ID of the attached user-assigned managed identity.
AZURE_CLIENT_ID=
# Local fallback only. Prefer Azure managed identity and never commit a real value.
ANKE_COSMOS_KEY=
